# Copy this file to .env and fill in every value, then run ./setup.sh
#
# Where each one comes from — every step here requires an authenticated
# browser session on that service, which is why this can't be scripted:

# --- Supabase (supabase.com → your project → Project Settings) -------------
# Project ref: the short ID in your project URL, e.g. "abcdefghijklmnop"
SUPABASE_PROJECT_REF=
# Access token: supabase.com/dashboard/account/tokens (create a new one)
SUPABASE_ACCESS_TOKEN=
# API → Project URL
SUPABASE_URL=
# API → Project API keys → anon / public, or the newer publishable key
# (safe to end up in app.json — this key is meant to be public; RLS is the
# actual boundary, see supabase/migrations/0003_rls.sql)
SUPABASE_ANON_KEY=
# Optional alias for newer Supabase projects. The app accepts either this or
# SUPABASE_ANON_KEY for client runtime config.
SUPABASE_PUBLISHABLE_KEY=
# Optional: only needed if you want `eas build` / `eas submit` tied to an
# existing Expo project without re-running `eas init`.
EAS_PROJECT_ID=

# --- Reddit (reddit.com/prefs/apps → create another app → type: script) ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Leave the next three blank unless you're adding NSFW subreddits — the
# default client_credentials grant cannot read over_18 content at all.
# See the comment in supabase/functions/ingest/adapters/reddit.ts.
# REDDIT_GRANT=password
# REDDIT_USERNAME=
# REDDIT_PASSWORD=

# --- YouTube (console.cloud.google.com → APIs & Services → Credentials) ----
# Create an API key, restrict it to "YouTube Data API v3"
YOUTUBE_API_KEY=

# --- NewsAPI (newsapi.org → account/dashboard) ------------------------------
# Optional. Only needed if you add newsapi sources for richer article feeds.
NEWSAPI_KEY=

# --- APITube (apitube.io → dashboard) ---------------------------------------
APITUBE_KEY=

# --- NewData.io (newdata.io → dashboard) ------------------------------------
NEWDATA_KEY=

# --- SearchCans (searchcans.com → dashboard) --------------------------------
SEARCHCANS_API_KEY=

# --- SociaVault (sociavault.com → dashboard) --------------------------------
SOCIAVAULT_KEY=

# --- Apify (apify.com → Settings → Integrations) ---------------------------
APIFY_KEY=

# --- Opus AI (opus.ai → API settings) --------------------------------------
OPUS_API_KEY=

# --- Zernio (zernio.com → dashboard) ----------------------------------------
ZERNIO_KEY=

# --- TikTok for Developers (developers.tiktok.com → Manage apps) -----------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- TikHub.io (tikhub.io → dashboard) -------------------------------------
TIKHUB_KEY=

# --- Generated automatically on first run, don't set this yourself ---------
# INGEST_SECRET=
